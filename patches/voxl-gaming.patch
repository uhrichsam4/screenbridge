new file mode 100644
index 0000000..99cdec6
--- /dev/null
+++ b/web/src/client/game.ts
@@ -0,0 +1,147 @@
+// Game mode (?game=1, or the toolbar button): a click locks the pointer to the desktop
+// and the mouse sends relative motion, for games with mouse-look. Hold W and press P,
+// or lose the lock any other way (Esc, switching windows), to pause: held keys and
+// buttons are released, input stops, and an overlay offers Resume and Leave.
+import { cmd } from '../protocol';
+import type { App } from './app';
+import { el } from './app';
+
+export interface Game {
+	/** A mouse press on the desktop: true when it was taken to lock the pointer. */
+	takeClick(e: PointerEvent): boolean;
+	/** Pointer motion while locked. */
+	motion(e: PointerEvent): void;
+	pause(): void;
+}
+
+/** `release` sends key-ups and button-ups for everything the page thinks is held. */
+export function createGame(app: App, release: () => void): Game {
+	const { surface } = app;
+	const btn = el<HTMLButtonElement>('game-btn');
+	const overlay = el('game-pause');
+	const resumeBtn = el<HTMLButtonElement>('game-resume');
+	const leaveBtn = el<HTMLButtonElement>('game-leave');
+	const note = el('game-note');
+	const canLock = 'requestPointerLock' in surface;
+
+	// Relative motion in desktop pixels, sent once per frame in whole pixels; the
+	// fractions carry over.
+	let ax = 0,
+		ay = 0,
+		queued = false;
+	function flush() {
+		queued = false;
+		const dx = Math.trunc(ax),
+			dy = Math.trunc(ay);
+		if (!dx && !dy) return;
+		ax -= dx;
+		ay -= dy;
+		app.send(cmd.moveRel(dx, dy));
+	}
+	function motion(e: PointerEvent) {
+		if (!app.desk.w || app.game.paused) return;
+		// movementX/Y are CSS pixels: devicePixelRatio device pixels each, while the
+		// desktop shows desk.w / width desktop pixels per CSS pixel, i.e. that over dpr
+		// per device pixel. The two dprs cancel, so the remote cursor moves as far
+		// across the shown desktop as the local mouse moved on screen.
+		const k = app.desk.w / surface.getBoundingClientRect().width;
+		ax += e.movementX * k;
+		ay += e.movementY * k;
+		if (!queued) {
+			queued = true;
+			requestAnimationFrame(flush);
+		}
+	}
+
+	async function lock(): Promise<boolean> {
+		try {
+			// Raw mouse counts, without the local pointer acceleration, where supported.
+			await surface.requestPointerLock({ unadjustedMovement: true });
+		} catch {
+			try {
+				await surface.requestPointerLock();
+			} catch (err) {
+				console.warn('[voxl] pointer lock failed', err);
+				return false;
+			}
+		}
+		return true;
+	}
+
+	function showOverlay(show: boolean) {
+		overlay.classList.toggle('show', show);
+		if (show) resumeBtn.focus({ preventScroll: true });
+		else app.kbd.focus({ preventScroll: true });
+	}
+
+	function pause() {
+		if (app.game.paused) return;
+		// Release while input still goes out, then stop it.
+		release();
+		app.game.paused = true;
+		ax = ay = 0;
+		if (document.pointerLockElement === surface) document.exitPointerLock();
+		note.textContent = '';
+		showOverlay(true);
+	}
+
+	function resumed() {
+		app.game.paused = false;
+		ax = ay = 0;
+		note.textContent = '';
+		showOverlay(false);
+	}
+
+	function setOn(on: boolean) {
+		app.game.on = on;
+		btn.classList.toggle('on', on);
+		btn.setAttribute('aria-pressed', String(on));
+		if (on) return;
+		if (app.game.paused) resumed();
+		if (document.pointerLockElement === surface) document.exitPointerLock();
+	}
+
+	document.addEventListener('pointerlockchange', () => {
+		const locked = document.pointerLockElement === surface;
+		if (locked === app.game.locked) return;
+		app.game.locked = locked;
+		if (locked) resumed();
+		// Esc, switching windows or the browser taking the lock back: same as W + P.
+		else if (app.game.on) pause();
+	});
+
+	resumeBtn.addEventListener('click', async () => {
+		note.textContent = '';
+		// Browsers refuse a new lock right after the viewer pressed Esc.
+		if (!(await lock()) && app.game.paused)
+			note.textContent = 'Click Resume again';
+	});
